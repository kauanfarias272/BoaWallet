rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Boa Wallet — Permissive rules for authenticated owners.
    // Each user can only read/write their OWN data under /users/{uid}/...
    // Any nested subcollection (subscriptions, adjustments, etc.) is
    // allowed, provided the authenticated UID matches the document path.
    // ===============================================================

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Any subcollection the app creates under the user's document
      // (subscriptions, adjustments, settings, exports, etc.)
      match /{collection}/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Deeper nesting if ever needed.
      match /{collection}/{docId}/{sub=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Legacy flat collection (pre-v1.7). Authenticated users may read/write
    // documents where the `user_id` field matches their UID. This lets the
    // app migrate old data to the new nested structure without permission
    // errors during the transition.
    match /subscriptions/{subId} {
      allow read, write: if request.auth != null &&
                           (!(resource != null) || resource.data.user_id == request.auth.uid) &&
                           (!(request.resource != null) || request.resource.data.user_id == request.auth.uid);
    }
  }
}
